    RewriteRule ^flyer-design/?$ /flyer-design-services-ahmedabad [R=301,L]

    # Additional Redirects
    RewriteRule ^magazine-and-booklet-design/?$ /magazine-and-booklet-design-ahmedabad [R=301,L]
