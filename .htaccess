<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Enforce HTTPS and Remove WWW (Domain Agnostic)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]
    
    # 301 Permanent Redirects (Relative to current domain)
    RewriteRule ^ui-ux-design-company-in-ahmedabad/?$ /ui-ux-design-agency-in-ahmedabad [R=301,L]
    RewriteRule ^web-development-company-in-ahmedabad/?$ /website-development-company-ahmedabad [R=301,L]
    RewriteRule ^digital-marketing/?$ /digital-marketing-agency-india [R=301,L]
    RewriteRule ^branding-and-identity-design/?$ /branding-and-identity-design-agency-ahmedabad [R=301,L]
    RewriteRule ^social-media-banner-design/?$ /social-media-banner-design-ahmedabad [R=301,L]
    RewriteRule ^flyer-design/?$ /flyer-design-services-ahmedabad [R=301,L]
    
    # Service Redirects
    RewriteRule ^wordpress/?$ /services/web-development/wordpress-development-company [R=301,L,NC]
    RewriteRule ^shopify/?$ /services/web-development/shopify-development-company [R=301,L,NC]
    RewriteRule ^webflow/?$ /services/web-development/webflow-development-company [R=301,L,NC]
    RewriteRule ^react-js/?$ /services/web-development/react-js-development-company [R=301,L,NC]
    
    # WordPress Sub-services
    RewriteRule ^learndash-design-and-development/?$ /services/web-development/wordpress-development-company [R=301,L]
    RewriteRule ^dokan-design-and-development/?$ /services/web-development/wordpress-development-company [R=301,L]
    RewriteRule ^responsive-wordpress-design/?$ /services/web-development/wordpress-development-company [R=301,L]
    RewriteRule ^figma-to-wordpress/?$ /services/web-development/wordpress-development-company [R=301,L]
    RewriteRule ^photoshop-to-wordpress/?$ /services/web-development/wordpress-development-company [R=301,L]
    RewriteRule ^html-to-wordpress/?$ /services/web-development/wordpress-development-company [R=301,L]
    RewriteRule ^theme-and-plugin-customization/?$ /services/web-development/wordpress-development-company [R=301,L]
    RewriteRule ^woocommerce-design-and-development/?$ /services/web-development/wordpress-development-company [R=301,L]
    RewriteRule ^wordpress-website-maintenance-and-support/?$ /services/web-development/wordpress-development-company [R=301,L]

    # Additional Redirects
    RewriteRule ^magazine-and-booklet-design/?$ /magazine-and-booklet-design-ahmedabad [R=301,L]
    RewriteRule ^event-invitation-design/?$ /event-invitation-design-ahmedabad [R=301,L]
    RewriteRule ^menu-design/?$ /menu-design-service-ahmedabad [R=301,L]
    RewriteRule ^signage-design/?$ /signage-design-service-ahmedabad [R=301,L]
    RewriteRule ^corporate-profile-design/?$ /corporate-profile-design-ahmedabad [R=301,L]
    RewriteRule ^annual-report-design/?$ /annual-report-design-agency-ahmedabad [R=301,L]
    RewriteRule ^digital-ad-design/?$ /digital-ad-design-agency-ahmedabad [R=301,L]
    RewriteRule ^trade-show-booth-design/?$ /exhibition-booth-design-ahmedabad/ [R=301,L]
    RewriteRule ^motion-graphics-design/?$ /motion-graphics-design-agency-ahmedabad [R=301,L]
    RewriteRule ^e-book-design/?$ /e-book-design-service-ahmedabad [R=301,L]
    RewriteRule ^how-ai-is-revolutionizing-seo-in-2025-human-centric-guide-for-business-growth/?$ /blog/how-ai-is-revolutionizing-seo-in-2025-human-centric-guide-for-business-growth [R=301,L]

    # Fallback to index.html for React Router
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
